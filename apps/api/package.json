{
  "name": "@scm/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@scm/db": "workspace:*",
    "@scm/doc-storage": "workspace:*",
    "@sentry/node": "^10.69.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.4",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.8",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
