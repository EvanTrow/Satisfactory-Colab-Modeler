# Copy this file to `infra/.env` (or export these in your shell) before
# running `docker compose -f infra/docker-compose.yml up`.
POSTGRES_USER=scm
POSTGRES_PASSWORD=scm
POSTGRES_DB=scm
POSTGRES_PORT=5432

# Connection string apps/api (and later, apps/realtime) read to reach the
# Postgres container started by infra/docker-compose.yml.
DATABASE_URL=postgresql://scm:scm@localhost:5432/scm

# Discord OAuth2 app credentials (apps/api/src/auth) — required for the api
# server to start at all (apps/api/src/index.ts registers the Discord auth
# routes eagerly). Register an application at https://discord.com/developers
# and add an OAuth2 redirect matching DISCORD_REDIRECT_URI exactly. In dev,
# apps/web's Vite server proxies /auth/* to apps/api (see
# apps/web/vite.config.ts), so the redirect URI is on the *web* port 5173,
# matching PLAN.md §9's verification bullet, even though apps/api itself
# listens on 3001.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# Secret(s) used to sign the short-lived (5 min) OAuth `state`/PKCE cookie
# set by GET /auth/discord/login (apps/api/src/auth/session-plugin.ts).
# NOT used for the sfm_session cookie itself, which carries an opaque random
# token looked up by hash rather than a signed value. Falls back to an
# insecure dev-only default if unset (see auth/config.ts) — set a real
# random value in any shared/production environment.
COOKIE_SECRET=
