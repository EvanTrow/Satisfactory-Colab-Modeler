# Copy this file to `infra/.env` (or export these in your shell) before
# running `docker compose -f infra/docker-compose.yml up`.
POSTGRES_USER=scm
POSTGRES_PASSWORD=scm
POSTGRES_DB=scm
POSTGRES_PORT=5432

# Connection string apps/api (and later, apps/realtime) read to reach the
# Postgres container started by infra/docker-compose.yml.
DATABASE_URL=postgresql://scm:scm@localhost:5432/scm

# Discord OAuth2 app credentials (apps/api/src/auth) — required for the api
# server to start at all (apps/api/src/index.ts registers the Discord auth
# routes eagerly). Register an application at https://discord.com/developers
# and add an OAuth2 redirect matching DISCORD_REDIRECT_URI exactly. In dev,
# apps/web's Vite server proxies /auth/* to apps/api (see
# apps/web/vite.config.ts), so the redirect URI is on the *web* port 5173,
# matching PLAN.md §9's verification bullet, even though apps/api itself
# listens on 3001.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# Secret(s) used to sign the short-lived (5 min) OAuth `state`/PKCE cookie
# set by GET /auth/discord/login (apps/api/src/auth/session-plugin.ts).
# NOT used for the sfm_session cookie itself, which carries an opaque random
# token looked up by hash rather than a signed value. Falls back to an
# insecure dev-only default if unset (see auth/config.ts) — set a real
# random value in any shared/production environment.
COOKIE_SECRET=

# Job 020 / PLAN.md §6: HS256 secret apps/api uses to sign, and
# apps/realtime uses to verify, the 60-second realtime connection ticket
# (GET /api/realtime/ticket -> wss://.../collab). MUST be the same value in
# both processes' environments — see apps/api/src/realtime/config.ts and
# apps/realtime/src/config.ts. Falls back to a matching insecure dev-only
# default in both if unset; set a real random value in any shared/production
# environment.
REALTIME_TICKET_SECRET=

# Job 020: shared secret apps/api sends (as the x-internal-secret header)
# when notifying apps/realtime's internal membership-changed webhook that a
# project_members row changed, so a force-disconnect can happen immediately
# rather than waiting for the hourly re-verification sweep. MUST match in
# both processes, same caveat as REALTIME_TICKET_SECRET above.
REALTIME_INTERNAL_SECRET=

# Job 020: base URL of apps/realtime's *internal* HTTP listener (not the
# public WebSocket port) — where apps/api posts membership-change
# notifications. Never expose this port publicly in a real deployment; only
# apps/api should be able to reach it.
REALTIME_INTERNAL_URL=http://127.0.0.1:1235

# Job 020: apps/realtime's own listen ports — REALTIME_PORT is the public
# Hocuspocus WebSocket (apps/web's Vite dev server proxies /collab to this,
# see apps/web/vite.config.ts), REALTIME_INTERNAL_PORT is what
# REALTIME_INTERNAL_URL above should point at. Both default sensibly
# (1234/1235, matching Hocuspocus's own conventional default for the first)
# if unset — only listed here for discoverability.
REALTIME_PORT=1234
REALTIME_INTERNAL_PORT=1235
